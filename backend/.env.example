PORT=8787
WEBTERMUX_SHARED_SECRET=replace-with-a-long-random-secret
SESSION_ROOT=/var/lib/webtermux/workspaces
SESSION_IDLE_MS=1800000
MAX_SESSIONS=25
CONTAINER_MEMORY=2g
CONTAINER_CPUS=2
CONTAINER_PIDS=256
DEBIAN_IMAGE=webtermux-debian:latest
UBUNTU_IMAGE=webtermux-ubuntu:latest
ARCH_IMAGE=webtermux-arch:latest
