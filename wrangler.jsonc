{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "termux-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "BACKEND_URL": "https://terminal-backend.internshield.in"
  }
}
